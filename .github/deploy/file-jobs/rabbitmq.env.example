# Copy to /opt/sqb/.env.rabbitmq, set a real password, chmod 600. Never commit that file.
# Docker Official Image tag verified on 20/11/2026; pin a pulled RepoDigest for rollout.
SQB_RABBITMQ_IMAGE=rabbitmq:4.4.1-management-alpine
SQB_RABBITMQ_NETWORK=sqb-network
SQB_RABBITMQ_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD
