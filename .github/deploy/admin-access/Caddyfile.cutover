# Final configuration based on the VPS Caddyfile supplied on 18/11/2026.
# Install admin-listener.caddy at /etc/caddy/sqb-admin.caddy before loading this file.
:80 {
	root * /usr/share/caddy
	file_server
}

topic1-server.whiteou7.id.vn {
	reverse_proxy localhost:3000
}

topic3-server.whiteou7.id.vn {
	reverse_proxy localhost:8082
}

hieudv.id.vn, www.hieudv.id.vn, snsqb.duckdns.org {
	request_body {
		max_size 50MB
	}

	route {
		# No public hostname may forward an ADMIN API, including over Tailscale.
		@blocked_admin_api path /api/v1/admin* /api/v1/auth/admin*
		respond @blocked_admin_api "Administrative API is only available on admin.hieudv.id.vn" 403

		@admin_page path_regexp admin_page (?i)^/admin(?:/|$)
		redir @admin_page https://admin.hieudv.id.vn{uri} 302

		handle /api/v1/* {
			reverse_proxy localhost:8085
		}

		handle {
			root * /var/www/sqb-frontend/dist
			try_files {path} /index.html
			file_server
		}
	}
}

# This creates no public HTTP/HTTPS site for admin.hieudv.id.vn.
import /etc/caddy/sqb-admin.caddy

cam.whiteou7.id.vn {
	reverse_proxy 127.0.0.1:3010
}

cam-s3.whiteou7.id.vn {
	reverse_proxy 127.0.0.1:9010
}
