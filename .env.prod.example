# ==============================================================================
# SQB PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# HƯỚNG DẪN DÀNH CHO QUẢN TRỊ SERVER (SYSADMIN / OPERATOR):
# 1. Copy file này thành .env.prod trên server production:
#      cp .env.prod.example .env.prod
# 2. Điền đầy đủ các thông tin bí mật thật vào bên dưới.
# 3. Chạy ứng dụng core:
#      docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
# 4. (Tùy chọn) Chạy monitoring stack:
#      docker compose --env-file .env.prod -f docker-compose.monitoring.yml up -d
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOCKER IMAGES & PORTS
# ------------------------------------------------------------------------------
# Tên GitHub Account/Org viết thường (lowercase)
BACKEND_IMAGE=ghcr.io/<your-github-username>/sqb-backend:latest
AI_SIDECAR_IMAGE=ghcr.io/<your-github-username>/sqb-ai-sidecar:latest
BACKEND_PORT=8080

# ------------------------------------------------------------------------------
# 2. DATABASE (POSTGRESQL + PGVECTOR)
# ------------------------------------------------------------------------------
DB_NAME=sqb_db
DB_USERNAME=postgres
DB_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_HERE

# ------------------------------------------------------------------------------
# 3. REDIS IN-MEMORY CACHE
# ------------------------------------------------------------------------------
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_HERE

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 OBJECT STORAGE (S3 COMPATIBLE - ZERO TAGGING)
# ------------------------------------------------------------------------------
# Lấy từ Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=YOUR_CLOUDFLARE_R2_ACCESS_KEY_ID
R2_SECRET_KEY=YOUR_CLOUDFLARE_R2_SECRET_ACCESS_KEY
R2_BUCKET=sqb-media
R2_REGION=auto
# Public Domain trỏ tới R2 bucket (ví dụ: https://pub-xxx.r2.dev hoặc https://media.yourdomain.com)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ------------------------------------------------------------------------------
# 5. JWT & SECURITY SECRETS
# ------------------------------------------------------------------------------
# JWT Secret tối thiểu 256-bit (chuỗi ngẫu nhiên dài >= 32 ký tự)
JWT_SECRET=GENERATE_A_VERY_LONG_SECURE_RANDOM_SECRET_KEY_FOR_JWT
SECRET_SALT=GENERATE_ANOTHER_RANDOM_SALT_FOR_PASSWORD_HASHING
DEFAULT_USER_PASSWORD=ChangeMeOnFirstLogin@123
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD_HERE

# ------------------------------------------------------------------------------
# 6. AI-SIDECAR & LLM (FASTAPI EMBEDDINGS & BTPROP CHECKER)
# ------------------------------------------------------------------------------
# URL mà Backend gọi sang AI Sidecar
AI_SERVER_URL=http://ai-sidecar:8000
AI_MODEL=text-embedding-3-small

# Cấu hình nội bộ cho chính container ai-sidecar:
# Hugging Face Token để download model text/image embeddings
HF_TOKEN=hf_YourHuggingFaceTokenHere
TEXT_MODEL=intfloat/multilingual-e5-small
IMAGE_MODEL=facebook/dinov2-small

# Khóa API OpenAI cho thuật toán kiểm định ảo giác BTProp
OPENAI_API_KEY=sk-proj-YourOpenAiApiKeyHere
BTPROP_MODEL=gpt-4.1-2025-04-14

# ------------------------------------------------------------------------------
# 7. MAIL NOTIFICATION (GMAIL SMTP)
# ------------------------------------------------------------------------------
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ------------------------------------------------------------------------------
# 8. FIREBASE PUSH NOTIFICATIONS (TÙY CHỌN)
# ------------------------------------------------------------------------------
# Cách 1 (Khuyên dùng): Encode file firebase-service-account.json thành Base64:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("backend/src/main/resources/firebase-service-account.json"))
#   Linux:      base64 -w 0 backend/src/main/resources/firebase-service-account.json
# Rồi paste chuỗi Base64 vào đây:
FIREBASE_CREDENTIALS_BASE64=

# Cách 2: Nếu mount file trực tiếp vào container:
# FIREBASE_CONFIG_PATH=file:/app/firebase-service-account.json

# ------------------------------------------------------------------------------
# 9. OBSERVABILITY & MONITORING STACK (TÙY CHỌN DÙNG VỚI docker-compose.monitoring.yml)
# ------------------------------------------------------------------------------

# Telegram Bot cảnh báo sự cố sập server / High error rate (Lấy từ @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=7368600631

# Tài khoản quản trị Grafana Dashboard UI
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=YOUR_STRONG_GRAFANA_PASSWORD_HERE
GRAFANA_PORT=3000

# Endpoint OTLP Traces (Mặc định tự động trỏ sang container tempo: http://tempo:4318/v1/traces nếu để trống)
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318/v1/traces


