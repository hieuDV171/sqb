<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="questions_template" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="24">
    <style name="Body" default="true" fontName="DejaVu Sans" fontSize="10.0"/>

    <dataset name="Images">
        <field name="_THIS" class="java.lang.String"/>
    </dataset>
    <dataset name="Options">
        <parameter name="INCLUDE_ANSWER" class="java.lang.Boolean"/>
        <field name="key" class="java.lang.String"/>
        <field name="text" class="java.lang.String"/>
        <field name="mediaUrl" class="java.lang.String"/>
        <field name="isCorrect" class="java.lang.Boolean"/>
    </dataset>

    <parameter name="SUBJECT_NAME" class="java.lang.String"/>
    <parameter name="INCLUDE_ANSWER" class="java.lang.Boolean"/>

    <field name="order" class="java.lang.Integer"/>
    <field name="questionContent" class="java.lang.String"/>
    <field name="questionImageUrls" class="java.util.List"/>
    <field name="options" class="java.util.List"/>
    <field name="explanation" class="java.lang.String"/>

    <title height="54" splitType="Stretch">
        <element kind="staticText" x="0" y="0" width="555" height="28"
                 hTextAlign="Center" bold="true" fontSize="16.0">
            <text>DANH SÁCH CÂU HỎI ÔN TẬP</text>
        </element>
        <element kind="textField" x="0" y="30" width="555" height="18"
                 positionType="Float" hTextAlign="Center" fontSize="11.0" textAdjust="StretchHeight">
            <expression><![CDATA["Môn học: " + $P{SUBJECT_NAME}]]></expression>
        </element>
    </title>
    <detail>
        <band height="46" splitType="Stretch">
            <element kind="textField" x="0" y="0" width="555" height="19" bold="true"
                     fontSize="11.0" textAdjust="StretchHeight">
                <expression><![CDATA["Câu " + $F{order} + ": " + $F{questionContent}]]></expression>
            </element>
            <element kind="component" x="20" y="20" width="535" height="1"
                     positionType="Float" removeLineWhenBlank="true">
                <component kind="list">
                    <datasetRun subDataset="Images">
                        <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($F{questionImageUrls})]]></dataSourceExpression>
                    </datasetRun>
                    <contents height="114" width="535">
                        <element kind="image" x="0" y="3" width="275" height="108"
                                 scaleImage="RetainShape" hImageAlign="Left" onErrorType="Blank">
                            <expression><![CDATA[$F{_THIS}]]></expression>
                        </element>
                    </contents>
                </component>
            </element>
            <element kind="component" x="20" y="22" width="535" height="1" positionType="Float">
                <component kind="list">
                    <datasetRun subDataset="Options">
                        <parameter name="INCLUDE_ANSWER">
                            <expression><![CDATA[$P{INCLUDE_ANSWER}]]></expression>
                        </parameter>
                        <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($F{options})]]></dataSourceExpression>
                    </datasetRun>
                    <contents height="19" width="535">
                        <element kind="textField" x="0" y="0" width="535" height="16" textAdjust="StretchHeight">
                            <expression><![CDATA[
                                $F{key} + ". " + java.util.Objects.toString($F{text}, "")
                                    + (Boolean.TRUE.equals($P{INCLUDE_ANSWER}) && Boolean.TRUE.equals($F{isCorrect}) ? " [Đáp án đúng]" : "")
                            ]]></expression>
                        </element>
                        <element kind="component" x="15" y="17" width="520" height="1"
                                 positionType="Float" removeLineWhenBlank="true">
                            <component kind="list">
                                <datasetRun subDataset="Images">
                                    <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($F{mediaUrl} == null || $F{mediaUrl}.isBlank()
                                                    ? java.util.Collections.emptyList() : java.util.Collections.singletonList($F{mediaUrl}))]]></dataSourceExpression>
                                </datasetRun>
                                <contents height="96" width="520">
                                    <element kind="image" x="0" y="3" width="275" height="90"
                                             scaleImage="RetainShape" hImageAlign="Left" onErrorType="Blank">
                                        <expression><![CDATA[$F{_THIS}]]></expression>
                                    </element>
                                </contents>
                            </component>
                        </element>
                    </contents>
                </component>
            </element>
            <element kind="textField" x="20" y="24" width="535" height="16" positionType="Float"
                     textAdjust="StretchHeight" removeLineWhenBlank="true" italic="true">
                <printWhenExpression><![CDATA[Boolean.TRUE.equals($P{INCLUDE_ANSWER})
                    && $F{explanation} != null && !$F{explanation}.isBlank()]]></printWhenExpression>
                <expression><![CDATA["Lời giải: " + $F{explanation}]]></expression>
            </element>
        </band>
    </detail>
    <pageFooter height="20">
        <element kind="textField" x="355" y="2" width="200" height="16" hTextAlign="Right" fontSize="9.0">
            <expression><![CDATA["Trang " + $V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
</jasperReport>
