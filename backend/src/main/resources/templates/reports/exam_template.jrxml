<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="exam_template" pageWidth="595" pageHeight="842" columnWidth="511"
              leftMargin="42" rightMargin="42" topMargin="36" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail">
    <style name="Body" default="true" fontName="DejaVu Sans" fontSize="10.0" forecolor="#1B2938"/>
    <style name="Category" style="Body" fontSize="9.0" forecolor="#1B344F" bold="true"/>
    <style name="Title" style="Body" fontSize="20.0" forecolor="#16273A" bold="true"/>
    <style name="Question" style="Body" fontSize="10.5" bold="true"/>
    <style name="Footer" style="Body" fontSize="8.0" forecolor="#526579"/>

    <dataset name="Images">
        <field name="_THIS" class="java.lang.String"/>
    </dataset>
    <dataset name="Options">
        <field name="key" class="java.lang.String"/>
        <field name="text" class="java.lang.String"/>
        <field name="mediaUrl" class="java.lang.String"/>
    </dataset>

    <parameter name="EXAM_TITLE" class="java.lang.String"/>
    <parameter name="REPORT_META" class="java.lang.String"/>
    <parameter name="INCLUDE_ANSWER" class="java.lang.Boolean"/>

    <field name="order" class="java.lang.Integer"/>
    <field name="questionContent" class="java.lang.String"/>
    <field name="questionImageUrls" class="java.util.List"/>
    <field name="options" class="java.util.List"/>
    <field name="correctAnswer" class="java.lang.String"/>

    <title height="109" splitType="Stretch">
        <element kind="line" x="0" y="0" width="511" height="1" forecolor="#1B344F">
            <pen lineWidth="2.5" lineColor="#1B344F"/>
        </element>
        <element kind="staticText" style="Category" x="0" y="13" width="511" height="15">
            <text>ĐỀ THI TRẮC NGHIỆM</text>
        </element>
        <element kind="textField" style="Title" x="0" y="30" width="511" height="29" textAdjust="StretchHeight">
            <expression><![CDATA[$P{EXAM_TITLE}]]></expression>
        </element>
        <element kind="textField" x="0" y="66" width="511" height="25" textAdjust="StretchHeight"
                 positionType="Float" mode="Opaque" backcolor="#EAF1F8" forecolor="#1B344F" vTextAlign="Middle">
            <box leftPadding="9" rightPadding="9" topPadding="4" bottomPadding="4"/>
            <expression><![CDATA[$P{REPORT_META}]]></expression>
        </element>
    </title>

    <detail>
        <band height="70" splitType="Prevent">
            <element kind="line" x="0" y="0" width="511" height="1">
                <pen lineWidth="0.6" lineColor="#C9D7E6"/>
            </element>
            <element kind="textField" style="Category" x="0" y="8" width="49" height="21"
                     mode="Opaque" backcolor="#EAF1F8" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA["Câu " + $F{order}]]></expression>
            </element>
            <element kind="textField" style="Question" x="63" y="9" width="448" height="18"
                     textAdjust="StretchHeight">
                <expression><![CDATA[java.util.Objects.toString($F{questionContent}, "")]]></expression>
            </element>

            <element kind="component" x="63" y="29" width="448" height="1"
                     positionType="Float" removeLineWhenBlank="true">
                <component kind="list">
                    <datasetRun subDataset="Images">
                        <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($F{questionImageUrls})]]></dataSourceExpression>
                    </datasetRun>
                    <contents height="124" width="448">
                        <element kind="image" x="0" y="4" width="405" height="114"
                                 scaleImage="RetainShape" hImageAlign="Left" onErrorType="Blank">
                            <expression><![CDATA[$F{_THIS}]]></expression>
                        </element>
                    </contents>
                </component>
            </element>

            <element kind="component" x="63" y="33" width="448" height="1" positionType="Float">
                <component kind="list">
                    <datasetRun subDataset="Options">
                        <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($F{options})]]></dataSourceExpression>
                    </datasetRun>
                    <contents height="20" width="448">
                        <element kind="textField" x="0" y="0" width="448" height="16" textAdjust="StretchHeight">
                            <expression><![CDATA[$F{key} + ". " + java.util.Objects.toString($F{text}, "")]]></expression>
                        </element>
                        <element kind="component" x="18" y="17" width="430" height="1"
                                 positionType="Float" removeLineWhenBlank="true">
                            <component kind="list">
                                <datasetRun subDataset="Images">
                                    <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource(
                                        $F{mediaUrl} == null || $F{mediaUrl}.isBlank() ? java.util.List.of() : java.util.List.of($F{mediaUrl}))]]></dataSourceExpression>
                                </datasetRun>
                                <contents height="102" width="430">
                                    <element kind="image" x="0" y="4" width="385" height="92"
                                             scaleImage="RetainShape" hImageAlign="Left" onErrorType="Blank">
                                        <expression><![CDATA[$F{_THIS}]]></expression>
                                    </element>
                                </contents>
                            </component>
                        </element>
                    </contents>
                </component>
            </element>

            <element kind="textField" x="63" y="39" width="448" height="22" positionType="Float"
                     textAdjust="StretchHeight" removeLineWhenBlank="true" mode="Opaque"
                     backcolor="#F2F6FA" forecolor="#1B344F" bold="true">
                <box leftPadding="8" rightPadding="8" topPadding="4" bottomPadding="4"/>
                <printWhenExpression><![CDATA[Boolean.TRUE.equals($P{INCLUDE_ANSWER})
                    && $F{correctAnswer} != null && !$F{correctAnswer}.isBlank()]]></printWhenExpression>
                <expression><![CDATA["Đáp án đúng: " + $F{correctAnswer}]]></expression>
            </element>
        </band>
    </detail>

    <pageFooter height="23">
        <element kind="line" x="0" y="0" width="511" height="1">
            <pen lineWidth="0.6" lineColor="#C9D7E6"/>
        </element>
        <element kind="staticText" style="Footer" x="0" y="6" width="320" height="15">
            <text>Đề thi trắc nghiệm</text>
        </element>
        <element kind="textField" style="Footer" x="351" y="6" width="160" height="15" hTextAlign="Right">
            <expression><![CDATA["Trang " + $V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
</jasperReport>
