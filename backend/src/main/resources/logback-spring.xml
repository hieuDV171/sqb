<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 
        Pattern cho Console:
        - %clr(%d{...}){faint}: Thời gian định dạng mờ nhẹ, tránh gây rối mắt
        - %clr(%-5level): Mức log theo chuẩn Spring (INFO=Xanh lá, WARN=Vàng, ERROR=Đỏ, DEBUG=Xanh lá)
        - %clr([trace:...]){cyan}: Trace/Correlation ID màu xanh lơ nổi bật
        - %clr([user:...]){yellow}: Danh tính user màu vàng ấm
        - %clr([%15.15t]){magenta}: Tên luồng (thread) màu tím cánh sen, căn lề 15 ký tự gọn gàng
        - %clr(%logger{36}){blue}: Tên class/logger màu xanh dương thanh thoát
    -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC}){faint} %clr(%-5level) %clr([trace:%X{traceId:-}]){cyan} %clr([user:%X{userId:-anon}]){magenta} %clr([%-15t]){green} %clr(%logger{36}){yellow} : %msg%n"/>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- File Appender với Rolling Policy (giữ log 14 ngày cho Promtail / Centralized Logging) -->
    <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/sqb-backend.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/sqb-backend-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC} %-5level [trace:%X{traceId:-}] [user:%X{userId:-anon}] [%t] %logger{36} : %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Development Profile: Ghi Console và ghi File để Promtail cào log -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ROLLING_FILE"/>
        </root>
        <logger name="com.frozenheart.backend" level="DEBUG"/>
        <logger name="org.springframework.security" level="INFO"/>
        <logger name="org.hibernate.sql" level="DEBUG"/>
    </springProfile>

    <!-- Production Profile: Console + Rolling File ghi đĩa -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ROLLING_FILE"/>
        </root>
        <logger name="com.frozenheart.backend" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
        <logger name="org.hibernate.sql" level="WARN"/>
    </springProfile>

    <!-- Default fallback khi không set profile -->
    <springProfile name="!dev &amp; !prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.frozenheart.backend" level="INFO"/>
    </springProfile>
</configuration>
